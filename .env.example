VITE_APP_NAME=FormaSpace
VITE_API_BASE_URL=/api

# 开发代理：后端 application.yml 默认地址，按实际运行环境调整；保留 /api 前缀。
# 此变量仅供 Vite 服务端使用，不暴露给浏览器。
API_PROXY_TARGET=http://127.0.0.1:8080

# 原生 WS 票据通过现有 /api 请求获取，/ws/generation 使用相同 Java 来源。
# Vite 已为 /ws 启用 ws:true；生产反向代理需同时转发 WebSocket Upgrade。
# 不配置浏览器长期 Token、Python 地址或 Python 服务凭证。

# 当前 Java 尚未部署浏览器票据和 WS，默认使用 HTTP 真实字段及点云恢复。
# 部署 /api/ws/tickets 与 /ws/generation 后，设置为 true 并重启前端。
VITE_GENERATION_WS_ENABLED=false
